// Общие настройки. DEVELOPMENT_TEAM задаётся локально в Local.xcconfig (не в git):
//   DEVELOPMENT_TEAM = XXXXXXXXXX
PRODUCT_BUNDLE_IDENTIFIER = io.github.realfamousbae.staya
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic


// Ядро собирается только под arm64 (Apple Silicon); Intel-симуляторы не поддерживаем.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

#include? "Local.xcconfig"
